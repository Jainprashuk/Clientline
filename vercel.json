{
  "version": 2,
  "regions": ["bom1"],
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["login.html", "css/**", "client/dist/**"],
        "maxDuration": 60
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "server.js" }]
}
