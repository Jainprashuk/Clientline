# Each environment sets its own values: a local .env holds dev, Vercel holds production.
NODE_ENV=dev
PORT=3001

# Clientline's own database — same Atlas cluster as Outreach, its own database name.
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/clientline_dev?appName=Cluster0

# The shared account store: the NAME of Outreach's database on that cluster.
AUTH_DB=outreach_dev

# Sign-in codes (same Resend account as Outreach). Unset locally = codes print to the server log.
RESEND_API_KEY=
OTP_FROM_EMAIL=
OTP_REPLY_TO=

# Public origin, for links in emails.
CLIENTLINE_URL=

# Optional, for `scripts/grant-access.js --env=prod` from this machine: production's
# values under _PROD names. Used only when the plain name above is not set.
# MONGODB_URI_PROD=
# AUTH_DB_PROD=outreach_prod
