# Local: dev. Deployed: prod.
NODE_ENV=dev
PORT=3001

# Clientline's own database — same Atlas cluster as Outreach, different database name.
MONGODB_URI_DEV=mongodb+srv://USER:PASS@cluster.mongodb.net/clientline_dev?appName=Cluster0
MONGODB_URI_PROD=mongodb+srv://USER:PASS@cluster.mongodb.net/clientline_prod?appName=Cluster0

# The shared account store: the NAME of Outreach's database on that cluster.
AUTH_DB_DEV=outreach_dev
AUTH_DB_PROD=outreach_prod

# Sign-in codes (same Resend account as Outreach). Unset locally = codes print to the server log.
RESEND_API_KEY=
OTP_FROM_EMAIL=
OTP_REPLY_TO=

# Public origin, for links in emails.
CLIENTLINE_URL=
