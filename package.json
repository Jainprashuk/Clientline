{
  "name": "clientline",
  "version": "0.1.0",
  "private": true,
  "description": "Clientline — leads, outreach, deals and invoices for freelancers",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm install && npm run build",
    "grant-access": "node scripts/grant-access.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "compression": "^1.8.2",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "imapflow": "^1.7.8",
    "inngest": "^4.26.2",
    "mailparser": "^3.14.1",
    "mongoose": "^9.7.0",
    "nodemailer": "^8.0.11",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4"
  }
}
